{
  "id": null,
  "title": "Order & Assembly Overview",
  "description": "Метрики OrderService и AssemblyService",
  "tags": ["orderservice", "assemblyservice", "prometheus"],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Orders Created Rate",
      "description": "Количество создания заказов (заказы/сек)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(order_service_order_total[1m])",
          "legendFormat": "orders/sec",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Orders Revenue",
      "description": "Выручка по заказам (по окну времени)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "increase(order_service_orders_revenue_currency_total[5m])",
          "legendFormat": "{{currency}} revenue",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currency",
          "min": 0
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "none" },
          "legend": { "displayMode": "table", "placement": "bottom" }
        }
      }
    },
    {
      "id": 3,
      "title": "Assembly Duration p95",
      "description": "95‑й перцентиль длительности сборки",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(assembly_service_assembly_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "{{method}} - p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    }
  ],
  "version": 1,
  "uid": "order-assembly-overview",
  "schemaVersion": 30
}
