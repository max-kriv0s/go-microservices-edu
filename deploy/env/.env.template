INVENTORY_IAM_GRPC_PORT=50053

# Логгер
INVENTORY_LOGGER_LEVEL=info
INVENTORY_LOGGER_AS_JSON=true
INVENTORY_LOG_OUTPUTS=stdout,otlp
INVENTORY_OTEL_COLLECTOR_ENDPOINT=otel-collector:4317
