# -----------------------------------------
# ОБЩИЙ ФАЙЛ КОНФИГУРАЦИИ МИКРОСЕРВИСНОЙ АРХИТЕКТУРЫ
# -----------------------------------------
# Этот файл содержит все переменные окружения для всех сервисов
# с префиксами для избежания конфликтов имен.
# -----------------------------------------

# -----------------------------------------
# CORE НАСТРОЙКИ (ОБЩИЕ КОМПОНЕНТЫ)
# -----------------------------------------

# Kafka настройки
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_CONTROLLER_PORT=29093
CORE_KAFKA_UI_PORT=8090

# OPENTELEMETRY COLLECTOR - ЦЕНТРАЛЬНЫЙ АГЕНТ СБОРА ТЕЛЕМЕТРИИ
# OpenTelemetry Collector получает метрики от сервисов и отправляет в ELK, Prometheus, Jagger
CORE_OTEL_IMAGE_NAME=otel/opentelemetry-collector-contrib:0.123.0

# Порты для приема телеметрических данных от приложений
CORE_OTEL_GRPC_PORT=4317 # Стандартный порт OTLP gRPC (рекомендуется)

# Настройки batch processor для оптимизации производительности
CORE_OTEL_BATCH_SIZE=1000 # Размер пакета метрик (баланс производительность/память)
CORE_OTEL_BATCH_TIMEOUT=10s # Максимальное время ожидания неполного пакета

# Порт для health check endpoint (используется Docker и системами мониторинга)
CORE_OTEL_METRICS_PORT=8889

# elasticsearch
CORE_ELASTICSEARCH_IMAGE_NAME=docker.elastic.co/elasticsearch/elasticsearch:9.0.4
CORE_ELASTICSEARCH_EXTERNAL_PORT=9200

# Kibana
CORE_KIBANA_IMAGE_NAME=docker.elastic.co/kibana/kibana:9.0.4
CORE_KIBANA_EXTERNAL_PORT=5601

# =============================================================================
# PROMETHEUS - БАЗА ДАННЫХ ВРЕМЕННЫХ РЯДОВ
# =============================================================================
# Prometheus хранит метрики и предоставляет их для Grafana

# Сетевые настройки Prometheus
CORE_PROMETHEUS_HOST=prometheus # Имя сервиса в Docker Compose
CORE_PROMETHEUS_PORT=9090 # Стандартный порт Prometheus

# Интервал оценки правил алертов (для будущего расширения)
CORE_PROMETHEUS_EVALUATION_INTERVAL=15s # Как часто проверять условия алертов

# =============================================================================
# GRAFANA - СИСТЕМА ВИЗУАЛИЗАЦИИ И ДАШБОРДОВ
# =============================================================================
# Grafana подключается к Prometheus и создает дашборды для мониторинга

# Сетевые настройки Grafana
CORE_GRAFANA_PORT=3000 # Стандартный порт Grafana

# Учетные данные администратора (измените в production!)
CORE_GRAFANA_ADMIN_USER=admin # Логин администратора
CORE_GRAFANA_ADMIN_PASSWORD=admin # Пароль администратора (ОБЯЗАТЕЛЬНО измените!)

# Настройки datasource для подключения к Prometheus
CORE_GRAFANA_DATASOURCE_NAME=Prometheus # Имя datasource в Grafana UI
CORE_GRAFANA_DATASOURCE_URL=http://prometheus:9090 # URL для подключения к Prometheus

# Путь к директории с JSON файлами дашбордов
CORE_GRAFANA_DASHBOARDS_PATH=/var/lib/grafana/dashboards # Путь в контейнере Grafana

# =============================================================================
# Jaeger
# =============================================================================
CORE_JAEGER_HOST=jaeger
CORE_JAEGER_PORT=4317
CORE_JAEGER_UI_PORT=16686

# -----------------------------------------
# IAM СЕРВИС
# -----------------------------------------

# gRPC настройки
IAM_GRPC_HOST=0.0.0.0
IAM_GRPC_PORT=50053

# Логгер
IAM_LOGGER_LEVEL=info
IAM_LOGGER_AS_JSON=true
IAM_LOG_OUTPUTS=stdout,otlp
IAM_OTEL_COLLECTOR_ENDPOINT=otel-collector:4317
IAM_SERVICE_NAME=iam
IAM_SERVICE_ENV=dev

# PostgreSQL
IAM_POSTGRES_IMAGE_NAME=postgres:17.0-alpine3.20
IAM_POSTGRES_HOST=localhost
IAM_POSTGRES_PORT=5444
IAM_EXTERNAL_POSTGRES_PORT=5444
IAM_POSTGRES_USER=iam_user
IAM_POSTGRES_PASSWORD=iam_password
IAM_POSTGRES_DB=iam
IAM_POSTGRES_SSL_MODE=disable
IAM_MIGRATION_DIRECTORY=./iam/migrations

# Redis
IAM_REDIS_IMAGE_NAME=redis:7.2.5-alpine3.20
IAM_REDIS_HOST=localhost
IAM_REDIS_PORT=6333
IAM_EXTERNAL_REDIS_PORT=6333
IAM_REDIS_CONNECTION_TIMEOUT=10s
IAM_REDIS_MAX_IDLE=10
IAM_REDIS_IDLE_TIMEOUT=10s

# Сессии
IAM_SESSION_TTL=24h

# -----------------------------------------
# INVENTORY СЕРВИС
# -----------------------------------------

# gRPC настройки
INVENTORY_GRPC_HOST=0.0.0.0
INVENTORY_GRPC_PORT=50051

# gRPC клиенты
